# ===== AudioFlow Docker 部署环境变量 =====
# 复制为 .env 后按需修改：
# cp .env.example .env

# Web UI 对外访问端口
WEB_PORT=8082

# 宿主机持久化目录
# 默认使用项目内相对路径，NAS 部署时可改成 /vol1/... 等绝对路径。
AUDIOFLOW_DATA_DIR=./data
AUDIOFLOW_CONFIG_DIR=./config
AUDIOFLOW_LOG_DIR=./logs
AUDIOFLOW_DOWNLOAD_DIR=./downloads

# 反向代理时的外部访问地址，可留空
# PUBLIC_BASE_URL=https://audioflow.example.com
PUBLIC_BASE_URL=

# 首次启动默认 Web 登录账号
# 登录后可在系统设置中修改密码，修改后会写入 CONFIG_DIR/auth.json。
AUDIOFLOW_DEFAULT_USERNAME=admin
AUDIOFLOW_DEFAULT_PASSWORD=admin

# 可选：设置后会加密保存 config/cookies.json 中的 Cookie。
# 请妥善保存该值，丢失后已加密 Cookie 无法解密。
AUDIOFLOW_COOKIE_SECRET=

# 安全开关：默认禁止直接把任意 url 传给 /api/proxy/audio。
# 正常试听会使用服务端签发的短期 token，不需要开启。
AUDIOFLOW_ALLOW_RAW_AUDIO_PROXY=false

# Optional Android-side signer. AudioFlow calls it before every premium
# Ximalaya V4 request. Keep this URL private and set a strong shared token.
# Docker Desktop: http://host.docker.internal:17891/ximalaya/ticket
# Linux Docker: use the host/LAN address reachable from the container.
XIMALAYA_TICKET_PROVIDER_URL=
XIMALAYA_TICKET_PROVIDER_TOKEN=
# local（默认，仅本地）/ auto（本地凭证无法生成时回退 Bridge）/ bridge（仅 Bridge）
XIMALAYA_TICKET_MODE=local

# 纯本地 V4 长任务保护：x-tk 是短期会话凭证，不应每集重新生成。
# 默认复用 15 分钟；V4 baseInfo 恢复高速请求，遇到真实风控后自动降速。
# 每小时硬上限默认关闭；特殊账号需要保守模式时可改为 480 或 540。
XIMALAYA_LOCAL_TICKET_TTL_SECONDS=900
XIMALAYA_V4_REQUESTS_PER_HOUR=0
XIMALAYA_V4_MIN_INTERVAL=0.75
XIMALAYA_V4_MAX_INTERVAL=30
XIMALAYA_V4_COOLDOWN_SECONDS=60
XIMALAYA_V4_MAX_COOLDOWN_SECONDS=3600

# ===== 懒人听书下载调优（可选）=====
# 并发下载线程数（1-3，默认 2）。只并行音频 CDN 下载；
# 取音频 URL 的请求由内置自适应节流统一控制，不会因此触发风控。
# LRTS_DOWNLOAD_THREADS=2
#
# 自适应节流参数（单位：秒）：
#   LRTS_MIN_REQUEST_INTERVAL  最快请求间隔下限（默认 0.5，最低 0.3）
#   LRTS_START_REQUEST_INTERVAL 启动时的保守间隔（默认 0.8）
#   LRTS_MAX_REQUEST_INTERVAL  触发风控后间隔上限（默认 8.0）
# 系统自动在"连续成功→提速到下限 / 触发 114 或非法请求→翻倍降速"间平衡。
# LRTS_MIN_REQUEST_INTERVAL=0.5
# LRTS_START_REQUEST_INTERVAL=0.8
# LRTS_MAX_REQUEST_INTERVAL=8.0
